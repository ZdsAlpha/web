# Porkbun API credentials
# Generate these at: https://porkbun.com/account/api
# Remember to enable API access for each domain you want to manage:
# Domain Management -> Details -> "API ACCESS" toggle

PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Optional, disabled-by-default S3 Zero proxy features. This token gates both
# the legacy B2 range route and the generic S3 proxy; it is not an encryption key.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_AUTHORIZE_URL=
VAULT_ACCESS_TOKEN=

# Optional, disabled-by-default generic S3 server proxy. It accepts credentials
# per request only after VAULT_ACCESS_TOKEN is supplied by the browser, and it
# requires HTTPS endpoints. Credentials are never persisted by the server.
VAULT_S3_PROXY_ENABLED=0
