package view

import (
	"fmt"
	"strconv"
)

const StableGANPath = "/demos/stable-gan"
const stableGANTitle = "Stable GAN Prototype"

templ Demos() {
	@Layout(Head{
		Title:       "Demos — " + authorName,
		Description: "Interactive experiments by Abdul Rahman.",
		Path:        "/demos",
	}) {
		<section class="intro">
			<h1>Demos</h1>
			<p class="muted">Try an experiment and see how it works.</p>
		</section>
		<ul class="post-list demo-list" role="list">
			<li class="post-item">
				<a class="post-link demo-entry" href={ StableGANPath }>
					<div>
						<h2 class="post-title">{ stableGANTitle }</h2>
						<p class="post-summary">Explore early Stable GAN results by generating four synthetic portraits and inspecting their RGB channels.</p>
						<p class="demo-entry-meta">256 × 256 portraits · Runs in your browser</p>
					</div>
					<img src="/static/img/imgen40/sample-4.webp" alt="" width="256" height="256"/>
				</a>
			</li>
		</ul>
	}
}

templ StableGANPrototype(modelURL string, modelBytes int64) {
	@Layout(Head{
		Title:       stableGANTitle + " — " + authorName,
		Description: "Explore early results from Stable GAN. Generate four synthetic portraits in your browser and inspect their RGB channels.",
		Path:        StableGANPath,
	}) {
		<article class="generator">
			<header class="generator-header">
				<a class="generator-back" href="/demos">← Demos</a>
				<h1>{ stableGANTitle }</h1>
				<p class="muted">An early look at Stable GAN. The generator turns random noise into 256 × 256 portraits in a single pass.</p>
			</header>
			<section class="generator-panel" aria-labelledby="generator-gallery-title">
				<div class="generator-action">
					<button
						id="generator-run"
						type="button"
						aria-describedby="generator-status"
						data-model-url={ modelURL }
						data-model-bytes={ strconv.FormatInt(modelBytes, 10) }
						disabled
					>Generate 4 images</button>
					<p id="generator-status" role="status">
						if modelURL == "" {
							The model is unavailable in this build. You can still inspect the example portraits.
						} else {
							{ fmt.Sprintf("First run downloads the %.0f MB model and a 15 MB runtime. Generation happens in your browser.", float64(modelBytes)/1e6) }
						}
					</p>
					<progress id="generator-progress" aria-label="Model download progress" max="100" hidden></progress>
				</div>
				<div class="generator-controls">
					<h2 id="generator-gallery-title">Example batch</h2>
					<label for="generator-channel">
						View
						<select id="generator-channel" disabled>
							<option value="rgb">RGB</option>
							<option value="red">Red channel</option>
							<option value="green">Green channel</option>
							<option value="blue">Blue channel</option>
						</select>
					</label>
				</div>
				<div class="generator-grid">
					for i := 1; i <= 4; i++ {
						<figure>
							<img
								src={ "/static/img/imgen40/sample-" + strconv.Itoa(i) + ".webp" }
								alt={ "Example generated portrait " + strconv.Itoa(i) }
								width="256"
								height="256"
							/>
							<canvas width="256" height="256" role="img" hidden></canvas>
							<figcaption>{ "Image " + strconv.Itoa(i) }</figcaption>
						</figure>
					}
				</div>
				<noscript><p>Enable JavaScript to generate portraits and inspect their channels.</p></noscript>
			</section>
			<section class="generator-inspect" aria-labelledby="generator-inspect-title">
				<h2 id="generator-inspect-title">How noise becomes an image</h2>
				<ol class="generator-flow">
					<li><strong>512 values</strong><span>Gaussian noise</span></li>
					<li><strong>8 × 8 grid</strong><span>Spatial projection</span></li>
					<li><strong>5 doublings</strong><span>Convolutions + Pixel Shuffle</span></li>
					<li><strong>256 × 256</strong><span>RGB output</span></li>
				</ol>
				<p>A linear layer projects the normalized noise into an 8 × 8 feature grid. At each larger resolution, convolutions mix nearby features and Pixel Shuffle moves channels into new pixel positions. A final convolution produces the red, green, and blue planes.</p>
				<p>Use <strong>View</strong> to isolate an output channel. Brighter areas show higher intensity in that channel. Compare the same portrait across channels to see how they combine into skin tones, shadows, and backgrounds.</p>
				<details>
					<summary>Model input and output</summary>
					<dl>
						<div><dt>Input</dt><dd><code>z</code> · 512 float32 noise values per image</dd></div>
						<div><dt>Output</dt><dd><code>image</code> · three 256 × 256 float32 planes, clamped to display range</dd></div>
						<div><dt>Weights</dt><dd>26.5 million parameters, stored as float16 and used as float32</dd></div>
					</dl>
				</details>
			</section>
		</article>
		<script type="module" src="/static/js/imgen40.js"></script>
	}
}
