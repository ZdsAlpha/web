package view

// Vault is the unlinked, browser-only storage workspace. Account and bucket
// data is managed entirely by /static/js/vault.js after this shell is loaded.
templ Vault() {
	@Layout(VaultHead()) {
		<section class="vault-shell" data-vault-app>
			<header class="vault-hero">
				<div>
					<p class="eyebrow">S3 Zero / local control plane</p>
					<h1>S3 Zero</h1>
					<p class="vault-lede">A browser-local workspace for encrypted objects on S3-compatible storage. Add a signing profile, register only the buckets you need, and decrypt object data on this device.</p>
				</div>
				<div class="local-badge" role="status"><span class="status-dot"></span> Local IndexedDB</div>
			</header>
			<div class="vault-notice" role="note">
				<strong>Local state. Explicit network paths.</strong>
				<span>Profiles, credentials, and master material are persisted only in this browser. Direct mode requires provider CORS; proxy mode forwards signed requests without retaining credentials or relaying plaintext. Exported JSON contains sensitive material.</span>
			</div>
			<div class="vault-layout">
				<aside class="vault-sidebar" aria-label="Storage vaults and registered buckets">
					<div class="panel-heading">
						<div>
							<p class="eyebrow">S3 profiles</p>
							<p class="account-count" id="vault-count">0 profiles</p>
						</div>
						<button class="small-button" id="add-vault" type="button">Add profile</button>
					</div>
					<div class="account-list" id="vault-list" aria-live="polite"></div>
					<div class="bucket-panel" id="bucket-panel" hidden>
						<div class="bucket-panel-heading">
							<div>
								<p class="eyebrow">Registered buckets</p>
								<p class="account-count" id="bucket-count">0 configured</p>
							</div>
							<button class="small-button small-button-secondary" id="add-bucket" type="button">Add bucket</button>
						</div>
						<div class="bucket-list" id="bucket-list"></div>
					</div>
					<div class="sidebar-actions">
						<button class="text-button" id="import-vaults" type="button">Import JSON</button>
						<button class="text-button" id="export-vaults" type="button">Export JSON</button>
						<input id="import-file" type="file" accept="application/json,.json" hidden/>
					</div>
				</aside>
				<section class="vault-workspace" aria-label="Vault workspace">
					<div class="vault-empty" id="welcome-state">
						<div class="empty-mark">S3</div>
						<p class="eyebrow">Initialize a profile</p>
						<h2>No S3 profiles</h2>
						<p class="muted">Start with an endpoint and AWS Signature V4 credentials. Register bucket-specific master material only when you need to browse encrypted objects.</p>
						<button class="primary-button" id="empty-add-vault" type="button">Create S3 profile</button>
					</div>
					<form class="account-form vault-form" id="vault-form" hidden novalidate>
						<div class="workspace-heading">
							<div>
								<p class="eyebrow">Connection profile</p>
								<h2 id="vault-form-title">New S3 profile</h2>
							</div>
							<button class="danger-button" id="delete-vault" type="button" hidden>Remove profile</button>
						</div>
						<fieldset>
							<legend>S3 endpoint &amp; signing credentials</legend>
							<div class="form-grid">
								<label>
									<span>Profile name <b aria-hidden="true">*</b></span>
									<input id="vault-name" name="name" type="text" placeholder="Research archive" autocomplete="organization" required/>
								</label>
								<label>
									<span>Signing region <b aria-hidden="true">*</b></span>
									<input id="vault-region" name="region" type="text" placeholder="us-east-1" autocomplete="off" required/>
									<small>Used in AWS Signature V4 requests.</small>
								</label>
							</div>
							<label>
								<span>S3-compatible endpoint <b aria-hidden="true">*</b></span>
								<input id="vault-endpoint" name="endpoint" type="url" placeholder="https://s3.amazonaws.com" autocomplete="url" required/>
								<small>Use the provider origin, including <code>https://</code>. AWS S3 is prefilled.</small>
							</label>
							<label>
								<span>Access key ID <b aria-hidden="true">*</b></span>
								<input id="vault-access-key" name="accessKeyId" type="text" spellcheck="false" autocomplete="username" required/>
							</label>
							<label>
								<span>Secret access key <b aria-hidden="true">*</b></span>
								<span class="secret-input"><input id="vault-secret-key" name="secretAccessKey" type="password" spellcheck="false" autocomplete="current-password" required/><button class="reveal-button" type="button" data-reveal="vault-secret-key" aria-label="Show secret access key">Show</button></span>
							</label>
							<details class="advanced-settings" id="advanced-s3-settings">
								<summary>Advanced S3 settings</summary>
								<p>Temporary credentials and endpoint-specific addressing options.</p>
								<label>
									<span>Session token <em>optional</em></span>
									<span class="secret-input"><input id="vault-session-token" name="sessionToken" type="password" spellcheck="false" autocomplete="off"/><button class="reveal-button" type="button" data-reveal="vault-session-token" aria-label="Show session token">Show</button></span>
									<small>Required only for temporary credentials.</small>
								</label>
								<label class="checkbox-label">
									<span>Addressing style</span>
									<span class="checkbox-control"><input id="vault-path-style" name="pathStyle" type="checkbox"/> Use path-style requests</span>
									<small>Most providers use virtual-hosted buckets. Enable this for path-style-compatible endpoints.</small>
								</label>
							</details>
							<fieldset class="transport-options">
								<legend>Default request path</legend>
								<label class="transport-option"><input id="vault-mode-direct" name="transportMode" type="radio" value="direct" checked/> <span><strong>Direct S3</strong><small>Browser → S3 endpoint. Requires CORS for this origin.</small></span></label>
								<label class="transport-option"><input id="vault-mode-proxy" name="transportMode" type="radio" value="proxy"/> <span><strong>Authenticated proxy</strong><small>Browser → this service → S3. For endpoints without CORS; request credentials are not retained server-side.</small></span></label>
								<small id="proxy-mode-message">Proxy availability is checked when this page opens.</small>
							</fieldset>
							<label id="proxy-token-field">
								<span>Proxy gate token <em>proxy mode only</em></span>
								<span class="secret-input"><input id="vault-proxy-token" name="proxyAccessToken" type="password" spellcheck="false" autocomplete="off"/><button class="reveal-button" type="button" data-reveal="vault-proxy-token" aria-label="Show server proxy access token">Show</button></span>
								<small>Must match <code>VAULT_ACCESS_TOKEN</code> on this deployment. It is sent only to this site.</small>
							</label>
						</fieldset>
						<section class="verification-card" aria-live="polite">
							<div class="verification-heading">
								<div>
									<p class="eyebrow">Connection verification</p>
									<h3 id="connection-state">Not tested</h3>
								</div>
								<button class="secondary-button" id="test-connection" type="button">Test connection</button>
							</div>
							<p class="verification-message" id="connection-message">Test a known bucket, or leave it empty to list the buckets visible to these credentials. A successful request unlocks this profile.</p>
							<label id="known-vault-bucket-field">
								<span>Known bucket <em>optional</em></span>
								<input id="known-vault-bucket" name="knownBucket" type="text" placeholder="my-bucket" autocomplete="off" spellcheck="false"/>
								<small>Use this when a provider permits bucket-scoped CORS but blocks account-wide bucket listing.</small>
							</label>
							<label id="available-buckets-field" hidden>
								<span id="available-buckets-label">Discovered buckets</span>
								<select id="available-buckets"></select>
							</label>
						</section>
						<div class="form-footer">
							<p class="form-hint" id="vault-form-hint">Required fields are marked with an asterisk.</p>
							<div class="form-actions">
								<button class="text-button" id="cancel-vault" type="button">Cancel</button>
								<button class="primary-button" id="save-vault" type="submit" hidden>Save vault</button>
							</div>
						</div>
					</form>
					<section class="bucket-form" id="bucket-form" hidden>
						<div class="workspace-heading">
							<div>
								<p class="eyebrow">Bucket setup</p>
								<h2>Register a bucket</h2>
							</div>
						</div>
						<p class="muted">The master file is stored locally as base64. Text is treated exactly like a small <code>.txt</code> file.</p>
						<label>
							<span>Bucket <b aria-hidden="true">*</b></span>
							<input id="bucket-choice" list="bucket-options" type="text" placeholder="Type or choose a bucket" autocomplete="off" spellcheck="false" required/>
							<datalist id="bucket-options"></datalist>
							<small>Type a bucket name directly, or choose one discovered during connection verification.</small>
						</label>
						<div class="master-source-grid">
							<label>
								<span>Master text</span>
								<textarea id="master-text" rows="6" placeholder="Paste or type the master text here"></textarea>
								<small>Use text or choose a file below. The selected file wins if both are provided.</small>
							</label>
							<label class="file-picker-label">
								<span>Master file</span>
								<input id="master-file" type="file"/>
								<small id="master-file-name">No file selected.</small>
							</label>
						</div>
						<div class="verification-card bucket-verification" aria-live="polite">
							<div class="verification-heading">
								<div>
									<p class="eyebrow">Bucket verification</p>
									<h3 id="bucket-state">Not verified</h3>
								</div>
								<button class="secondary-button" id="verify-bucket" type="button">Verify bucket</button>
							</div>
							<p class="verification-message" id="bucket-message">This checks that the selected bucket can be listed with the tested credentials.</p>
						</div>
						<div class="form-footer">
							<p class="form-hint" id="bucket-form-hint">A master text or file is required before saving the bucket.</p>
							<div class="form-actions">
								<button class="text-button" id="cancel-bucket" type="button">Cancel</button>
								<button class="primary-button" id="save-bucket" type="button" hidden>Register bucket</button>
							</div>
						</div>
					</section>
					<section class="file-manager" id="file-manager" hidden>
						<div class="file-manager-heading">
							<div>
								<p class="eyebrow">File manager</p>
								<h2 id="file-manager-title">Select a bucket</h2>
								<p class="muted" id="file-manager-subtitle">Register a bucket to browse its objects.</p>
							</div>
							<div class="file-manager-actions">
								<div class="open-mode-toggle" role="group" aria-label="Connection mode for this bucket">
									<button class="mode-button" id="open-mode-direct" type="button">Direct</button>
									<button class="mode-button" id="open-mode-proxy" type="button">Proxy</button>
								</div>
								<button class="secondary-button permission-action" id="upload-files" type="button" disabled title="Upload permission has not been verified">Upload</button>
								<button class="secondary-button permission-action" id="delete-files" type="button" disabled title="Delete permission has not been verified">Delete</button>
								<button class="secondary-button" id="edit-vault" type="button">Edit vault</button>
								<button class="secondary-button" id="refresh-files" type="button">Refresh</button>
								<input id="upload-input" type="file" multiple hidden/>
							</div>
						</div>
						<nav class="breadcrumbs" id="breadcrumbs" aria-label="Current folder"></nav>
						<div class="file-list" id="file-list" role="table" aria-label="Bucket objects"></div>
						<p class="file-manager-status" id="file-manager-status" role="status"></p>
					</section>
					<dialog class="viewer-dialog" id="viewer-dialog" aria-labelledby="viewer-title">
						<div class="viewer-header">
							<div><p class="eyebrow">Client-side viewer</p><h2 id="viewer-title">Preview</h2></div>
							<button class="secondary-button" id="close-viewer" type="button">Close</button>
						</div>
						<p class="viewer-status" id="viewer-status">Loading encrypted object…</p>
						<div class="viewer-stage" id="viewer-stage">
							<img id="viewer-image" alt="" hidden/>
							<video id="viewer-video" controls playsinline hidden></video>
							<p class="viewer-message" id="viewer-message" hidden></p>
						</div>
					</dialog>
					<div class="vault-toast" id="vault-toast" role="status" aria-live="polite" hidden></div>
				</section>
			</div>
		</section>
		<script src="/static/js/vault.js?v=5" defer></script>
	}
}
